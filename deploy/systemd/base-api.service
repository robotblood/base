[Unit]
Description=base — FastAPI backend
# Postgres runs in Docker (restart: unless-stopped); api-serve.sh waits up to
# 60s for it, then systemd retries below as a backstop.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/base/scripts/api-serve.sh
WorkingDirectory=%h/base
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
